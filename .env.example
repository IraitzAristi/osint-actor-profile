# Copy to ".env" and fill in what you have. Every key is OPTIONAL:
# the tool runs with whatever is set and skips the rest.
# Keyless sources always work: crt.sh, RDAP, RIPEstat, Shodan InternetDB, SSLBL feeds.

# abuse.ch, ONE key for ThreatFox + URLhaus (+ MalwareBazaar).
# Get it free at https://auth.abuse.ch/  (log in with GitHub/Google, add a 2nd provider).
ABUSECH_AUTH_KEY=

# VirusTotal public API (free: ~4 req/min, 500/day)
VT_API_KEY=


# AlienVault OTX (free)
OTX_API_KEY=


# NOTE (by design, not in this file):
#   * Censys free tier no longer allows search via API -> use its web console manually.
#   * ThreatFox API omits IOCs older than 6 months -> pull historical seeds from
#     Sekoia's dated IOC CSVs / vendor reports, not the live API.
